generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nombre   String
  email    String   @unique
  password String
  rol      Rol      @default(VISUALIZADOR)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())
}

enum Rol {
  ADMIN
  OPERADOR
  EVALUADOR
  VISUALIZADOR
}

model Empleado {
  id                  Int                 @id @default(autoincrement())
  nombre              String
  cedula              String              @unique
  rango               String
  tipoPersonal        TipoPersonal        @default(OPERATIVO)
  grupoOperativo      GrupoOperativo?
  grupoEcu            GrupoEcu?
  estacionId          Int?
  activo              Boolean             @default(true)
  creadoEn            DateTime            @default(now())
  estacion            Estacion?           @relation(fields: [estacionId], references: [id])
  asignaciones        Asignacion[]
  ausencias           Ausencia[]
  evaluaciones        Evaluacion[]
  historialEstaciones HistorialEstacion[]
}

enum TipoPersonal {
  OPERATIVO
  ECU
  ADMINISTRATIVO
}

enum GrupoOperativo {
  GRUPO_1
  GRUPO_2
  GRUPO_3
}

enum GrupoEcu {
  ECU_1
  ECU_2
  ECU_3
  ECU_4
}

model Estacion {
  id           Int                 @id @default(autoincrement())
  nombre       String
  direccion    String?
  empleados    Empleado[]
  asignaciones Asignacion[]
  historial    HistorialEstacion[]
}

model Asignacion {
  id         Int      @id @default(autoincrement())
  empleadoId Int
  estacionId Int
  fecha      DateTime @db.Date
  turno      String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  estacion   Estacion @relation(fields: [estacionId], references: [id])

  @@unique([empleadoId, fecha, turno])
}

model Ausencia {
  id          Int          @id @default(autoincrement())
  empleadoId  Int
  tipo        TipoAusencia
  fechaInicio DateTime     @db.Date
  fechaFin    DateTime     @db.Date
  descripcion String?
  empleado    Empleado     @relation(fields: [empleadoId], references: [id])
}

enum TipoAusencia {
  VACACIONES
  ENFERMEDAD
  PERMISO
  FALTA
}

model Evaluacion {
  id          Int            @id @default(autoincrement())
  empleadoId  Int
  tipo        TipoEvaluacion
  descripcion String
  fecha       DateTime       @default(now())
  empleado    Empleado       @relation(fields: [empleadoId], references: [id])
}

enum TipoEvaluacion {
  POSITIVO
  NEGATIVO
}

model HistorialEstacion {
  id          Int       @id @default(autoincrement())
  empleadoId  Int
  estacionId  Int
  fechaInicio DateTime  @db.Date
  fechaFin    DateTime? @db.Date
  empleado    Empleado  @relation(fields: [empleadoId], references: [id])
  estacion    Estacion  @relation(fields: [estacionId], references: [id])
}