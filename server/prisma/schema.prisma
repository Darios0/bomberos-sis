generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  password     String
  rol          Rol      @default(VISUALIZADOR)
  activo       Boolean  @default(false)
  aprobado     Boolean  @default(false)
  cedula       String?  @unique
  creadoEn     DateTime @default(now())
}

enum Rol {
  ADMIN
  OPERADOR
  EVALUADOR
  VISUALIZADOR
}

model Empleado {
  id                  Int                 @id @default(autoincrement())
  nombre              String
  cedula              String              @unique
  rango               String
  antiguedad          Int                 @default(99)
  tipoPersonal        TipoPersonal        @default(OPERATIVO)
  grupoOperativo      GrupoOperativo?
  grupoEcu            GrupoEcu?
  estacionId          Int?
  esParamedico        Boolean             @default(false)
  activo              Boolean             @default(true)
  creadoEn            DateTime            @default(now())
  estacion            Estacion?           @relation(fields: [estacionId], references: [id])
  asignaciones        Asignacion[]
  ausencias           Ausencia[]
  evaluaciones        Evaluacion[]
  historialEstaciones HistorialEstacion[]
  distributivoItems   DistributivoItem[]
  reemplazosComoOriginal  Reemplazo[] @relation("ReemplazoOriginal")
reemplazosComoSuplente  Reemplazo[] @relation("ReemplazoSuplente")
}

enum TipoPersonal {
  OPERATIVO
  ECU
  ADMINISTRATIVO
}

enum GrupoOperativo {
  GRUPO_1
  GRUPO_2
  GRUPO_3
}

enum GrupoEcu {
  ECU_1
  ECU_2
  ECU_3
  ECU_4
}

model Estacion {
  id           Int                 @id @default(autoincrement())
  nombre       String
  direccion    String?
  empleados    Empleado[]
  asignaciones Asignacion[]
  historial    HistorialEstacion[]
  distributivoItems   DistributivoItem[]
  reemplazos Reemplazo[]
}

model Asignacion {
  id         Int      @id @default(autoincrement())
  empleadoId Int
  estacionId Int
  fecha      DateTime @db.Date
  turno      String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  estacion   Estacion @relation(fields: [estacionId], references: [id])

  @@unique([empleadoId, fecha, turno])
}

model Ausencia {
  id            Int          @id @default(autoincrement())
  empleadoId    Int
  tipo          TipoAusencia
  fechaInicio   DateTime     @db.Date
  fechaFin      DateTime     @db.Date
  horaInicio    String?
  horaFin       String?
  descripcion   String?
  tipoPermiso   String?
  creadoEn      DateTime     @default(now())
  empleado      Empleado     @relation(fields: [empleadoId], references: [id])
}

enum TipoAusencia {
  VACACIONES
  ENFERMEDAD
  PERMISO
  FALTA
  ATRASO
}

model Evaluacion {
  id          Int            @id @default(autoincrement())
  empleadoId  Int
  tipo        TipoEvaluacion
  descripcion String
  fecha       DateTime       @default(now())
  creadoEn    DateTime       @default(now())
  empleado    Empleado       @relation(fields: [empleadoId], references: [id])
}

enum TipoEvaluacion {
  MERITO
  DEMERITO
}

model HistorialEstacion {
  id          Int       @id @default(autoincrement())
  empleadoId  Int
  estacionId  Int
  fechaInicio DateTime  @db.Date
  fechaFin    DateTime? @db.Date
  empleado    Empleado  @relation(fields: [empleadoId], references: [id])
  estacion    Estacion  @relation(fields: [estacionId], references: [id])
}
model Distributivo {
  id         Int                  @id @default(autoincrement())
  mes        Int
  anio       Int
  grupo      GrupoOperativo?
  esEcu      Boolean              @default(false)
  publicado  Boolean              @default(false)
  creadoEn   DateTime             @default(now())
  items      DistributivoItem[]

  @@unique([mes, anio, grupo])
}

model DistributivoItem {
  id             Int          @id @default(autoincrement())
  distributivoId Int
  empleadoId     Int
  estacionId     Int?
  esEcu          Boolean      @default(false)
  esAdmin        Boolean      @default(false)
  esJornadaEcu   Boolean      @default(false)
  orden          Int          @default(0)
  distributivo   Distributivo @relation(fields: [distributivoId], references: [id])
  empleado       Empleado     @relation(fields: [empleadoId], references: [id])
  estacion       Estacion?    @relation(fields: [estacionId], references: [id])
}

model Notificacion {
  id          Int                 @id @default(autoincrement())
  titulo      String
  mensaje     String
  urgencia    NivelUrgencia       @default(NORMAL)
  destinatario Destinatario       @default(TODOS)
  creadoPor   Int
  creadoEn    DateTime            @default(now())
  lecturas    NotificacionLeida[]
}

enum Destinatario {
  TODOS
  GRUPO_1
  GRUPO_2
  GRUPO_3
}

model NotificacionLeida {
  id              Int          @id @default(autoincrement())
  notificacionId  Int
  usuarioId       Int
  leidoEn         DateTime     @default(now())
  notificacion    Notificacion @relation(fields: [notificacionId], references: [id])
}

enum NivelUrgencia {
  NORMAL
  URGENTE
  EMERGENCIA
}

model Reemplazo {
  id              Int      @id @default(autoincrement())
  fecha           DateTime @db.Date
  empleadoOriginalId Int
  empleadoReemplazoId Int
  estacionId      Int?
  grupoEcu        GrupoEcu?
  esEcu           Boolean  @default(false)
  motivo          String?
  aprobado        Boolean  @default(true)
  creadoEn        DateTime @default(now())
  creadoPor       Int

  empleadoOriginal  Empleado  @relation("ReemplazoOriginal",  fields: [empleadoOriginalId],  references: [id])
  empleadoReemplazo Empleado  @relation("ReemplazoSuplente",  fields: [empleadoReemplazoId], references: [id])
  estacion          Estacion? @relation(fields: [estacionId], references: [id])
}