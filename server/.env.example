# ============================================================================
# BOMBEROS SIS - BACKEND ENVIRONMENT (For Local Development Only)
# ============================================================================
#
# ⚠️  IMPORTANTE: En producción, usar .env en la raíz del proyecto
#
# Para despliegue en Docker, usar:
#   cp ../.env.example ../.env
#   Luego editar ../.env con valores de producción
#
# ============================================================================

# Database configuration (local development)
DATABASE_URL="postgresql://postgres:dev123@localhost:5432/bomberos_db"

# JWT Secret (local testing - CHANGE IN PRODUCTION)
JWT_SECRET="dev_secret_key_for_local_testing_only_change_in_production"

# Server configuration
PORT=3001
NODE_ENV=development

# ============================================================================
# For production deployment with Docker:
#
# 1. Go to project root: cd ..
# 2. Copy environment file: cp .env.example .env
# 3. Edit production values: nano .env
# 4. Run deployment: bash docker-deploy.sh
#
# The .env file will be automatically sourced by docker-compose.yml
# ============================================================================
