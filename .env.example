# ============================================================================
# BOMBEROS SIS - DOCKER ENVIRONMENT CONFIGURATION
# ============================================================================
# 
# Copy this file to .env and update all values for your environment.
# NEVER commit .env to version control.
#
# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL User (must be non-postgres for security)
DB_USER=bomberos

# PostgreSQL Password (CHANGE THIS - use strong password in production)
# Minimum 16 characters: mix of uppercase, lowercase, numbers, special chars
DB_PASSWORD=GenerateStrongPassword123!@#

# Database name
DB_NAME=bomberos_db

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Node environment
NODE_ENV=production

# Backend port (internal, proxied by Nginx)
PORT=3001

# JWT Secret for token signing (CHANGE THIS - use strong random string)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_strong_random_jwt_secret_here_minimum_32_characters_long

# ============================================================================
# NGINX CONFIGURATION (Optional)
# ============================================================================

# Server name / domain (optional, for SSL certificates)
SERVER_NAME=bomberos.example.com

# ============================================================================
# OPTIONAL: REVERSE PROXY BEHIND ANOTHER NGINX/LOAD BALANCER
# ============================================================================

# Enable if running behind another reverse proxy
# TRUST_PROXY=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# 1. Database Password:
#    - Must be at least 16 characters
#    - Use mix of: uppercase, lowercase, numbers, special characters
#    - Example: BomberosApp@2024Key!
#
# 2. JWT Secret:
#    - Generate with: openssl rand -hex 32
#    - Must be at least 32 characters
#    - Store securely, never share
#
# 3. File Permissions:
#    - chmod 600 .env (read-only by owner)
#    - Keep in version control .gitignore
#
# ============================================================================
